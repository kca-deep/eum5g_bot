# Dify API Configuration
# Chat App API Key (Dify 앱 > API 접근 에서 발급)
DIFY_API_KEY=app-your-dify-api-key
DIFY_BASE_URL=https://api.dify.ai/v1

# Knowledge Base (Dataset) Configuration
# Dataset API Key는 Chat App Key와 별도 (Dify 콘솔 > 지식베이스 > API Key에서 발급)
DIFY_DATASET_API_KEY=dataset-your-dataset-api-key
DIFY_DATASET_ID=your-dataset-id

# News API (프로덕션 배포 시 설정, 비어있으면 초기 뉴스 로드 생략)
NEXT_PUBLIC_NEWS_API_URL=

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5-nano
