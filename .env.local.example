# 이음5G AI 챗봇 환경변수 예시
# 사용법: cp .env.local.example .env.local 후 실제 값 입력
# 운영(Vercel)에는 아래 [필수] 8개(Dify 3·OpenAI 2·Supabase 2·CRON_SECRET)를 Production 환경변수로 등록

# ─── [필수] Dify 지식베이스 (RAG 검색) ───
# Dify 콘솔 > 지식베이스 > API 에서 발급
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_DATASET_API_KEY=dataset-xxxxxxxxxxxxxxxx
DIFY_DATASET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── [필수] OpenAI (답변 생성) ───
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# ─── [필수·처리 기록] Supabase (AI 성과측정 표준 로그) ───
# 미설정 시 처리 기록을 남기지 않고 답변만 동작한다. 스키마: supabase/migrations/
# 서버 전용 키이므로 NEXT_PUBLIC_ 접두어를 붙이지 않는다.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx

# ─── [필수·운영] 매일 상태 유지 호출 (vercel.json crons → /api/cron/keepalive) ───
# Dify Cloud는 미사용 지식베이스를 무료 7일·유료 30일 뒤 자동 비활성화하므로 하루 1회 검색을 보낸다.
# Vercel Cron이 Authorization: Bearer <값>으로 호출한다. 생성 예: openssl rand -hex 32 (운영 Production에만 등록)
CRON_SECRET=xxxxxxxx

# ─── [선택] 미설정 시 기본값 동작 ───
# 추론형 모델(o·gpt-5 이후) 추론 강도: none|minimal|low|medium|high|xhigh (미설정 = medium)
OPENAI_REASONING_EFFORT=medium
# OPENAI_REWRITE_MODEL=     # 후속 질문 검색어 재작성 모델 (기본 gpt-4o-mini)
# OPENAI_TEMPERATURE=       # 명시 시에만 temperature 전달 (gpt-5 계열은 미설정 권장)
# RAG_SCORE_THRESHOLD=0.4   # Dify 검색 최소 유사도 (기본 0.4)
# RAG_DEBUG=                # 1 설정 시 검색 결과 상세 로그 (운영 설정 금지)
# NEXT_PUBLIC_SUPPORT_PHONE= # 대화 종료 카드에 표시할 지원센터 대표번호 (비우면 지원포털 링크만 표시)
